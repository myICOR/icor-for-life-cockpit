#!/bin/sh
# ---------------------------------------------------------------------------
# Start the ICOR for Life - Cockpit {{VERSION}}
#
# Generated by scripts/make-launcher.mjs from launcher/start-cockpit.sh.template.
# Read it before you run it: it is short on purpose.
#
# What it does, in order:
#   1. goes to the Cockpit folder,
#   2. checks that Node.js is new enough,
#   3. checks that the install and the build were done,
#   4. opens http://127.0.0.1:{{PORT}} in your browser once,
#   5. runs the Cockpit in THIS window. Close the window or press Ctrl+C to stop.
#
# What it never does: install anything, add a login item, a launch agent, a
# cron job or any other thing that starts by itself. When this window is
# closed, the Cockpit is not running. Nothing here writes to your notes.
#
# On a Mac, double-click this file (it opens in Terminal). On Linux, run it
# from a terminal: sh "<this file>".
# ---------------------------------------------------------------------------

COCKPIT_DIR="{{COCKPIT_DIR}}"
PORT="{{PORT}}"
URL="http://127.0.0.1:$PORT"

cd "$COCKPIT_DIR" || { echo "  Cockpit folder not found: $COCKPIT_DIR"; exit 1; }

if ! command -v node >/dev/null 2>&1; then
  echo "  Node.js is not installed. Install the current LTS from https://nodejs.org, then run this again."
  exit 1
fi
node scripts/check-node.cjs || exit 1

if [ ! -d node_modules ] || [ ! -f web/dist/index.html ]; then
  echo "  The Cockpit is not installed yet. In this folder run:"
  echo "    npm run install:all"
  echo "    npm run build"
  echo "  then start this launcher again."
  exit 1
fi

# Open the browser once, two seconds after start. This is a one-shot helper
# that ends by itself; it is not a service. COCKPIT_NO_BROWSER=1 skips it.
if [ -z "$COCKPIT_NO_BROWSER" ]; then
  (
    sleep 2
    if command -v open >/dev/null 2>&1; then open "$URL"
    elif command -v xdg-open >/dev/null 2>&1; then xdg-open "$URL" >/dev/null 2>&1
    fi
  ) &
fi

export PORT
exec node server/server.js
