@echo off
rem ---------------------------------------------------------------------------
rem Start the ICOR for Life - Cockpit {{VERSION}}
rem
rem Generated by scripts\make-launcher.mjs from launcher\start-cockpit.cmd.template.
rem Read it before you run it: it is short on purpose.
rem
rem What it does, in order:
rem   1. goes to the Cockpit folder,
rem   2. checks that Node.js is new enough,
rem   3. checks that the install and the build were done,
rem   4. opens http://127.0.0.1:{{PORT}} in your browser once,
rem   5. runs the Cockpit in THIS window. Close the window or press Ctrl+C to stop.
rem
rem What it never does: install anything, add a Startup entry, a Run key, a
rem scheduled task or any other thing that starts by itself. When this window
rem is closed, the Cockpit is not running. Nothing here writes to your notes.
rem
rem Double-click this file to start the Cockpit.
rem ---------------------------------------------------------------------------

setlocal
set "COCKPIT_DIR={{COCKPIT_DIR}}"
set "PORT={{PORT}}"
set "URL=http://127.0.0.1:%PORT%"

cd /d "%COCKPIT_DIR%" || (echo   Cockpit folder not found: "%COCKPIT_DIR%" & pause & exit /b 1)

where node >nul 2>nul || (echo   Node.js is not installed. Install the current LTS from https://nodejs.org, then run this again. & pause & exit /b 1)
node scripts\check-node.cjs || (pause & exit /b 1)

if not exist node_modules (goto notinstalled)
if not exist web\dist\index.html (goto notinstalled)

rem Open the browser once, two seconds after start. It ends by itself.
rem COCKPIT_NO_BROWSER=1 skips it.
if not defined COCKPIT_NO_BROWSER start "" /b cmd /c "timeout /t 2 /nobreak >nul & start "" %URL%"

node server\server.js
exit /b %ERRORLEVEL%

:notinstalled
echo   The Cockpit is not installed yet. In this folder run:
echo     npm run install:all
echo     npm run build
echo   then start this launcher again.
pause
exit /b 1
